      "Text": {
        "text": {
          "literalString": "{{label}}"
        },
        "usageHint": "caption",
        "style": {
          "color": "{{color}}"
        }
      }
    }
  },
  {
    "id": "{{a_id}}",
    "component": {
      "Button": {
